<!-- report.wxml -->
<view class="container">
  <view class="section">
    <view class="section-title">选择订单</view>
    <picker bindchange="bindOrderChange" value="{{orderIndex}}" range="{{orders}}" range-key="title">
      <view class="picker">
        {{selectedOrder ? selectedOrder.title : '请选择要举报的订单'}}
      </view>
    </picker>
  </view>
  
  <view class="section">
    <view class="section-title">举报理由</view>
    <textarea 
      class="textarea" 
      placeholder="请详细描述虚假订单的情况" 
      value="{{reason}}" 
      bindinput="bindReasonInput"
      maxlength="500"
    />
    <view class="count">{{reason.length}}/500</view>
  </view>
  
  <button class="submit-btn" bindtap="submitReport" disabled="{{!selectedOrder || reason.length < 10}}">
    提交举报
  </button>
  
  <view class="tips">
    <text>举报说明：</text>
    <text>1. 请确保举报信息真实有效</text>
    <text>2. 管理员会在24小时内核实处理</text>
    <text>3. 恶意举报将影响您的账号信用</text>
  </view>
</view>