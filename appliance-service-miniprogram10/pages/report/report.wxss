/* report.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 100rpx;
}

.section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.picker {
  width: 100%;
  padding: 24rpx;
  background-color: #F9F9F9;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666666;
  border: 1rpx solid #EEEEEE;
}

.textarea {
  width: 100%;
  height: 240rpx;
  padding: 24rpx;
  background-color: #F9F9F9;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
  border: 1rpx solid #EEEEEE;
  resize: none;
  box-sizing: border-box;
}

.count {
  font-size: 24rpx;
  color: #999999;
  text-align: right;
  margin-top: 12rpx;
}

.submit-btn {
  width: 100%;
  padding: 28rpx;
  background-color: #1E88E5;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.submit-btn:disabled {
  background-color: #CCCCCC;
}

.tips {
  background-color: #FFF8E1;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #FF9800;
  line-height: 1.5;
}

.tips text {
  display: block;
  margin-bottom: 12rpx;
}

.tips text:first-child {
  font-weight: 500;
  margin-bottom: 16rpx;
}