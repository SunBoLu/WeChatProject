/* rating.wxss */
.container {
  flex: 1;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

.header {
  background-color: #1E88E5;
  color: white;
  padding: 30rpx;
  text-align: center;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
}

.content {
  background-color: white;
  margin: 20rpx;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.service-info {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.service-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.service-type {
  font-size: 24rpx;
  color: #1E88E5;
  background-color: #E3F2FD;
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.rating-section {
  margin-bottom: 30rpx;
}

.rating-label {
  font-size: 26rpx;
  margin-bottom: 20rpx;
  display: block;
}

.stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 48rpx;
  color: #ccc;
  margin-right: 20rpx;
  cursor: pointer;
}

.star.active {
  color: #FFC107;
}

.comment-section {
  position: relative;
}

.comment-label {
  font-size: 26rpx;
  margin-bottom: 10rpx;
  display: block;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 24rpx;
  resize: none;
}

.comment-count {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: #999;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.submit-btn {
  background-color: #1E88E5;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  width: 100%;
}

.submit-btn:hover {
  background-color: #1976D2;
}