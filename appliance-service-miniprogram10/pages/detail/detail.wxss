/* detail.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 详情卡片 */
.detail-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.05), 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
}

.detail-tag {
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 16rpx;
}

.tag-primary {
  background-color: rgba(30, 136, 229, 0.1);
  color: #1E88E5;
}

.tag-secondary {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.tag-success {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.detail-description {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.detail-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
}

/* 联系人卡片 */
.contact-card, .provider-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.05), 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.contact-label {
  font-size: 28rpx;
  color: #666666;
}

.contact-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 服务方信息 */
.provider-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.provider-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  overflow: hidden;
  margin-right: 16rpx;
  background-color: #F5F5F5;
  flex-shrink: 0;
}

.provider-avatar image {
  width: 100%;
  height: 100%;
}

.provider-details {
  flex: 1;
  min-width: 0;
}

.provider-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.provider-rating {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.stars {
  display: flex;
  margin-right: 8rpx;
}

.star-icon {
  width: 20rpx;
  height: 20rpx;
  margin-right: 4rpx;
}

.rating-text {
  font-size: 20rpx;
  color: #FF9800;
}

.provider-stats {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEEEEE;
  flex-wrap: wrap;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 80rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  word-break: break-all;
  text-align: center;
}

/* 底部操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
  box-sizing: border-box;
}

.btn-group {
  display: flex;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 0;
}

.btn-outline {
  border: 1rpx solid #1E88E5;
  color: #1E88E5;
  background-color: #FFFFFF;
}

.btn-primary {
  background-color: #1E88E5;
  color: #FFFFFF;
}

.btn-secondary {
  background-color: #FF9800;
  color: #FFFFFF;
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* 状态指示器 */
.status-indicator {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-item {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s;
  min-width: 80rpx;
}

/* 状态颜色 */
.pending-status {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
  border: 1rpx solid rgba(255, 152, 0, 0.3);
}

.accepted-status {
  background-color: rgba(30, 136, 229, 0.1);
  color: #1E88E5;
  border: 1rpx solid rgba(30, 136, 229, 0.3);
}

.completed-status {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
  border: 1rpx solid rgba(76, 175, 80, 0.3);
}

/* 激活状态 */
.status-item.active {
  font-weight: 600;
  transform: translateY(-2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  min-width: 80rpx;
}

.pending-status.active {
  background-color: #FF9800;
  color: #FFFFFF;
}

.accepted-status.active {
  background-color: #1E88E5;
  color: #FFFFFF;
}

.completed-status.active {
  background-color: #4CAF50;
  color: #FFFFFF;
}

/* 最终金额高亮 */
.final-amount-section {
  margin-top: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  border-radius: 12rpx;
  border-left: 6rpx solid #1E88E5;
}

.final-amount-label {
  font-size: 24rpx;
  color: #1E88E5;
  margin-bottom: 8rpx;
}

.final-amount-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E88E5;
}

/* 状态文字 */
.status-text {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  font-weight: 500;
}

.status-pending {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.status-accepted {
  background-color: rgba(30, 136, 229, 0.1);
  color: #1E88E5;
}

.status-in_service {
  background-color: rgba(30, 136, 229, 0.1);
  color: #1E88E5;
}

.status-completed {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.status-paid {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.status-rated {
  background-color: rgba(156, 39, 176, 0.1);
  color: #9C27B0;
}

/* QR code 卡片 */
.qr-code-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.05), 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
  border-left: 6rpx solid #E53935;
}

.qr-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.qr-info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.qr-label {
  font-size: 24rpx;
  color: #666666;
  flex-shrink: 0;
}

.qr-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  word-break: break-all;
}

.qr-code-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
  padding: 24rpx;
  background-color: #F9F9F9;
  border-radius: 12rpx;
}

.qr-code-image {
  width: 100%;
  max-width: 400rpx;
  margin-top: 16rpx;
  border-radius: 8rpx;
}

.qr-divider {
  height: 1rpx;
  background-color: #EEEEEE;
  margin: 32rpx 0;
}

.qr-empty {
  text-align: center;
  padding: 32rpx;
  color: #999999;
  font-size: 24rpx;
}

/* 删除按钮样式 */
.delete-button-container {
  margin-bottom: 16rpx;
}

.delete-button {
  width: 100%;
  border: 1rpx solid #E53935;
  color: #E53935;
  background-color: #FFFFFF;
}

.delete-button:hover {
  background-color: rgba(229, 57, 53, 0.05);
}