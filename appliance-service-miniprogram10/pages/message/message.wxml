<!-- message.wxml -->
<view class="container">
  <view class="header">
    <text class="title">消息通知</text>
    <text class="unread-count" wx:if="{{unreadCount > 0}}">{{unreadCount}}</text>
  </view>
  
  <scroll-view class="message-list" scroll-y="true">
    <block wx:if="{{messages.length > 0}}">
      <view 
        class="message-item {{item.read ? 'read' : 'unread'}}" 
        wx:for="{{messages}}" 
        wx:key="id" 
        data-id="{{item.id}}" 
        bindtap="markAsRead"
      >
        <view class="message-content">
          <view class="message-header">
            <text class="message-title">{{item.title || '聊天消息'}}</text>
            <text class="message-time">{{formatDate(item.createdAt)}}</text>
          </view>
          <text class="message-text">{{item.content}}</text>
        </view>
        <view class="message-status" wx:if="{{!item.read}}">
          <view class="unread-dot"></view>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <image src="https://p3-flow-imagex-sign.byteimg.com/tos-cn-i-a9rns2rl98/rc/pc/super_tool/7f0a90291aa04befa256ff9ca44388f3~tplv-a9rns2rl98-image.image?lk3s=8e244e95&rcl=20260401092055155D53C067306AAA622F&rrcfp=f06b921b&x-expires=1777598527&x-signature=rwgjH27F4eQZBOGfXxwmOd4RpOU%3D" class="empty-icon"></image>
      <text class="empty-text">暂无消息</text>
    </view>
  </scroll-view>
</view>