/* feedback-manage.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.header {
  margin-bottom: 32rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.header-subtitle {
  font-size: 24rpx;
  color: #666666;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.filter-item {
  padding: 12rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #666666;
  white-space: nowrap;
  border: 1rpx solid #EEEEEE;
}

.filter-item.active {
  background-color: #4CAF50;
  color: #FFFFFF;
  border-color: #4CAF50;
}

.status-filter {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.status-item {
  flex: 1;
  padding: 12rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  border-radius: 8rpx;
}

.status-item.active {
  background-color: #E8F5E8;
  color: #4CAF50;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.feedback-item {
  border-left: 4rpx solid #FF9800;
}

.report-item {
  border-left: 4rpx solid #F44336;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-type {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.feedback-type {
  background-color: #FFF3E0;
  color: #FF9800;
}

.report-type {
  background-color: #FFEBEE;
  color: #F44336;
}

.item-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.status-pending {
  background-color: #FFF3E0;
  color: #FF9800;
}

.status-processed {
  background-color: #E8F5E8;
  color: #4CAF50;
}

.status-rejected {
  background-color: #FFEBEE;
  color: #F44336;
}

.item-content {
  display: flex;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.content-label {
  font-size: 24rpx;
  color: #999999;
  width: 140rpx;
  flex-shrink: 0;
}

.content-value {
  font-size: 24rpx;
  color: #333333;
  flex: 1;
  word-break: break-all;
}

.item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  padding: 16rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  height: 64rpx;
  line-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reject-btn {
  background-color: #F5F5F5;
  color: #666666;
}

.process-btn {
  background-color: #4CAF50;
  color: #FFFFFF;
}

.empty-tip {
  text-align: center;
  padding: 64rpx 24rpx;
  color: #999999;
  font-size: 24rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  margin-top: 32rpx;
}

/* 底部导航栏 */
.admin-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #FFFFFF;
  display: flex;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  color: #999999;
}

.tab-item.active {
  color: #4CAF50;
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 20rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .header-title {
    font-size: 32rpx;
  }
  
  .content-label {
    font-size: 22rpx;
    width: 120rpx;
  }
  
  .content-value {
    font-size: 22rpx;
  }
  
  .admin-tab-bar {
    height: 90rpx;
  }
  
  .tab-icon {
    font-size: 28rpx;
  }
  
  .tab-text {
    font-size: 18rpx;
  }
}

@media (min-width: 768px) {
  .container {
    padding: 32rpx;
    padding-bottom: 200rpx;
  }
  
  .header-title {
    font-size: 40rpx;
  }
  
  .item {
    padding: 32rpx;
  }
  
  .content-label {
    font-size: 26rpx;
  }
  
  .content-value {
    font-size: 26rpx;
  }
  
  .admin-tab-bar {
    height: 120rpx;
  }
  
  .tab-icon {
    font-size: 36rpx;
  }
  
  .tab-text {
    font-size: 24rpx;
  }
}
