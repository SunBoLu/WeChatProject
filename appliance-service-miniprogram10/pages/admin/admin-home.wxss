/* admin-home.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.header {
  margin-bottom: 32rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.header-subtitle {
  font-size: 24rpx;
  color: #666666;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 1rpx solid #EEEEEE;
  box-sizing: border-box;
  min-height: 80rpx;
}

.search-btn {
  padding: 0 32rpx;
  background-color: #1E88E5;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 8rpx;
  height: 80rpx;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.filter-item {
  padding: 12rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #666666;
  white-space: nowrap;
  border: 1rpx solid #EEEEEE;
}

.filter-item.active {
  background-color: #1E88E5;
  color: #FFFFFF;
  border-color: #1E88E5;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-item {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-left: 4rpx solid #1E88E5;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.order-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background-color: #E3F2FD;
  color: #1E88E5;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 2rpx solid #F0F0F0;
}

.order-info text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.detail-btn {
  flex: 1;
  padding: 16rpx;
  background-color: #F5F5F5;
  color: #333333;
  font-size: 24rpx;
  border-radius: 8rpx;
  height: 64rpx;
  line-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn {
  flex: 1;
  padding: 16rpx;
  background-color: #E53935;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 8rpx;
  height: 64rpx;
  line-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-tip {
  text-align: center;
  padding: 64rpx 24rpx;
  color: #999999;
  font-size: 24rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  margin-top: 32rpx;
}

.placeholder {
  color: #999999;
  font-size: 24rpx;
}

/* 底部导航栏 */
.admin-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #FFFFFF;
  display: flex;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  color: #999999;
}

.tab-item.active {
  color: #4CAF50;
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 20rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .header-title {
    font-size: 32rpx;
  }
  
  .search-input {
    font-size: 26rpx;
  }
  
  .order-title {
    font-size: 26rpx;
  }
  
  .order-info text {
    font-size: 22rpx;
  }
  
  .admin-tab-bar {
    height: 90rpx;
  }
  
  .tab-icon {
    font-size: 28rpx;
  }
  
  .tab-text {
    font-size: 18rpx;
  }
}

@media (min-width: 768px) {
  .container {
    padding: 32rpx;
  }
  
  .header-title {
    font-size: 40rpx;
  }
  
  .order-item {
    padding: 32rpx;
  }
  
  .order-title {
    font-size: 30rpx;
  }
  
  .order-info text {
    font-size: 26rpx;
  }
  
  .admin-tab-bar {
    height: 120rpx;
  }
  
  .tab-icon {
    font-size: 36rpx;
  }
  
  .tab-text {
    font-size: 24rpx;
  }
}