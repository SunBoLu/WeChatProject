/* admin-profile.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.header {
  margin-bottom: 32rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.header-subtitle {
  font-size: 24rpx;
  color: #666666;
}

.user-info {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #1E88E5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.user-phone {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: block;
}

.user-role {
  font-size: 20rpx;
  color: #1E88E5;
  background-color: #E3F2FD;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  display: inline-block;
}

.section {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.add-admin-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input {
  width: 100%;
  padding: 28rpx 24rpx;
  background-color: #F9F9F9;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 1rpx solid #EEEEEE;
  box-sizing: border-box;
  min-height: 80rpx;
}

.placeholder {
  color: #999999;
  font-size: 24rpx;
}

.add-btn {
  width: 100%;
  background-color: #4CAF50;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.admin-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #F9F9F9;
  border-radius: 8rpx;
}

.admin-info {
  flex: 1;
}

.admin-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
  display: block;
}

.admin-phone {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 4rpx;
  display: block;
}

.admin-role {
  font-size: 20rpx;
  color: #4CAF50;
  background-color: #E8F5E8;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  display: inline-block;
}

.delete-admin-btn {
  padding: 12rpx 24rpx;
  background-color: #E53935;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 8rpx;
  height: 64rpx;
  line-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-code-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.qr-code-preview {
  width: 100%;
  display: flex;
  justify-content: center;
}

.qr-code-img {
  width: 100%;
  max-width: 400rpx;
  border-radius: 12rpx;
}

.qr-code-empty {
  padding: 48rpx;
  text-align: center;
}

.qr-empty-text {
  font-size: 24rpx;
  color: #999999;
}

.upload-qr-btn {
  width: 100%;
  padding: 24rpx;
  background-color: #1E88E5;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 8rpx;
  height: 72rpx;
  line-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  padding: 24rpx;
  background-color: #1E88E5;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 8rpx;
  height: 72rpx;
  line-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.system-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 24rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.empty-tip {
  text-align: center;
  padding: 48rpx;
  color: #999999;
  font-size: 24rpx;
  background-color: #F9F9F9;
  border-radius: 8rpx;
}

.logout-btn {
  width: 100%;
  padding: 24rpx;
  background-color: #9E9E9E;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin-top: 24rpx;
  margin-bottom: 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底部导航栏 */
.admin-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #FFFFFF;
  display: flex;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  color: #999999;
}

.tab-item.active {
  color: #4CAF50;
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 20rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .header-title {
    font-size: 32rpx;
  }
  
  .user-name {
    font-size: 28rpx;
  }
  
  .input {
    font-size: 26rpx;
  }
  
  .admin-name {
    font-size: 26rpx;
  }
  
  .info-label {
    font-size: 22rpx;
  }
  
  .info-value {
    font-size: 26rpx;
  }
  
  .admin-tab-bar {
    height: 90rpx;
  }
  
  .tab-icon {
    font-size: 28rpx;
  }
  
  .tab-text {
    font-size: 18rpx;
  }
}

@media (min-width: 768px) {
  .container {
    padding: 32rpx;
    padding-bottom: 170rpx;
  }
  
  .header-title {
    font-size: 40rpx;
  }
  
  .user-info {
    padding: 40rpx;
  }
  
  .section {
    padding: 32rpx;
  }
  
  .user-name {
    font-size: 36rpx;
  }
  
  .admin-name {
    font-size: 30rpx;
  }
  
  .info-value {
    font-size: 32rpx;
  }
  
  .admin-tab-bar {
    height: 120rpx;
  }
  
  .tab-icon {
    font-size: 36rpx;
  }
  
  .tab-text {
    font-size: 24rpx;
  }
}