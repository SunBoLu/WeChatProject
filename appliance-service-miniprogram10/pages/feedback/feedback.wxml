<!-- feedback.wxml -->
<view class="container">
  <view class="section">
    <view class="section-title">选择服务方</view>
    <picker bindchange="bindProviderChange" value="{{providerIndex}}" range="{{providers}}" range-key="name">
      <view class="picker">
        {{selectedProvider ? selectedProvider.name : '请选择服务方'}}
      </view>
    </picker>
  </view>
  
  <view class="section">
    <view class="section-title">反馈问题</view>
    <textarea 
      class="textarea" 
      placeholder="请详细描述服务方的违规行为" 
      value="{{problem}}" 
      bindinput="bindProblemInput"
      maxlength="500"
    />
    <view class="count">{{problem.length}}/500</view>
  </view>
  
  <button class="submit-btn" bindtap="submitFeedback" disabled="{{!selectedProvider || problem.length < 10}}">
    提交反馈
  </button>
  
  <view class="tips">
    <text>反馈说明：</text>
    <text>1. 请确保反馈信息真实有效</text>
    <text>2. 管理员会在24小时内核实处理</text>
    <text>3. 恶意反馈将影响您的账号信用</text>
  </view>
</view>