/**
 * 全局样式
 */

/* 全局重置 */
page {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  background-color: #F5F5F5;
  color: #333333;
  min-height: 100vh;
}

view, text, image, button, input, textarea, picker {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 颜色变量 */
:root {
  --primary-color: #1E88E5;
  --secondary-color: #FF9800;
  --light-color: #F5F5F5;
  --dark-color: #333333;
  --gray-medium-color: #666666;
  --gray-light-color: #999999;
  --border-light-color: #EEEEEE;
}

/* 工具类 */
.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

.text-center {
  text-align: center;
}

.text-primary {
  color: var(--primary-color);
}

.text-secondary {
  color: var(--secondary-color);
}

.text-gray-medium {
  color: var(--gray-medium-color);
}

.text-gray-light {
  color: var(--gray-light-color);
}

.bg-white {
  background-color: #FFFFFF;
}

.bg-primary {
  background-color: var(--primary-color);
}

.bg-secondary {
  background-color: var(--secondary-color);
}

.rounded-lg {
  border-radius: 8rpx;
}

.rounded-full {
  border-radius: 9999rpx;
}

.shadow-sm {
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.shadow {
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.05), 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

.mb-2 {
  margin-bottom: 16rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

.mb-4 {
  margin-bottom: 32rpx;
}

.mb-6 {
  margin-bottom: 48rpx;
}

.mt-2 {
  margin-top: 16rpx;
}

.mt-3 {
  margin-top: 24rpx;
}

.mt-4 {
  margin-top: 32rpx;
}

.mt-6 {
  margin-top: 48rpx;
}

.ml-2 {
  margin-left: 16rpx;
}

.ml-3 {
  margin-left: 24rpx;
}

.mr-2 {
  margin-right: 16rpx;
}

.mr-3 {
  margin-right: 24rpx;
}

.p-2 {
  padding: 16rpx;
}

.p-3 {
  padding: 24rpx;
}

.p-4 {
  padding: 32rpx;
}

.p-6 {
  padding: 48rpx;
}

.px-2 {
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.px-3 {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.px-4 {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.py-2 {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.py-3 {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.py-4 {
  padding-top: 32rpx;
  padding-bottom: 32rpx;
}

/* 表单样式 */
.input-field {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 1rpx solid var(--border-light-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--dark-color);
  background-color: #FFFFFF;
}

.input-field:focus {
  border-color: var(--primary-color);
  outline: none;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.btn-primary {
  background-color: #FFFFFF;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  box-shadow: 0 2rpx 4rpx rgba(30, 136, 229, 0.1);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  background-color: var(--primary-color);
  color: #FFFFFF;
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background-color: var(--secondary-color);
  color: #FFFFFF;
  box-shadow: 0 2rpx 4rpx rgba(255, 152, 0, 0.3);
}

.btn-secondary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-outline {
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
  background-color: #FFFFFF;
}

.btn-outline:active {
  background-color: var(--primary-color);
  color: #FFFFFF;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 6rpx rgba(0, 0, 0, 0.05), 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.card:active {
  transform: scale(0.98);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-primary {
  background-color: rgba(30, 136, 229, 0.1);
  color: var(--primary-color);
}

.tag-secondary {
  background-color: rgba(255, 152, 0, 0.1);
  color: var(--secondary-color);
}

.tag-success {
  background-color: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease-in-out;
}

.animate-slide-up {
  animation: slideUp 0.5s ease-in-out;
}